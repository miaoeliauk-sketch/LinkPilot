{
  "name": "inkpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "background": "tsx src/background-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:assets": "tsx scripts/generate-assets.ts",
    "compose": "tsx src/cli.ts",
    "diagnose": "tsx src/voice/cli.ts",
    "intensity": "tsx src/intensity-cli.ts",
    "record": "tsx src/record-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
